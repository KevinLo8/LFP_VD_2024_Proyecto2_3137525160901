/ Si te jalan las operaciones, ya ganaste LFP

// Configuraciones para el Léxico
Configuraci0nesLex = [
    fondo: "#000000",
    fuente: "#FFFFFF",
    forma: "circle",
    tipoFuente: "Times-Roman"
]

// Configuraciones para el sintáctico
ConfiguracionesParser = [
    fondo: "#f3ff00",
    fuente: "#000000",
    forma: "box",
    tipoFuente: "Arial"
]

imprimir("Funciones de Reportería")
conteo() // Te debe de devolver 10 funciones en total
promedio("suma") // Son 6 operaciones suma en total, deberías de poderle sacar el promedio
max("multiplicacion") // Te debe de devolver el 379817.18 de la operación 10, ya que es una multiplicación
min("raiz") // Te debe de devolver 2.52, ya que es el valor mínimo de raíz que existe
generarReporte("tokens") // Generamos reporte de tokens en HTML por favor, nada de consola
generarReporte("errores","201700761") // Tu reporte de errores, tanto léxicos como sintácticos
generarReporte("arbol", "New Arbolito") // Tús árboles, bien hechos con graphviz

imprimir("Felicidades, si llegaste hasta acá, significa que ganaste LFP")